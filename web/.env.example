# Copy to .env.local (never committed) and fill in. All values are baked into the public bundle.

# JSON-RPC endpoint for reads, log scans and the wallet transport. Use a key restricted to your domain.
VITE_RPC_URL=
# VaultFactory address (0x...).
VITE_FACTORY=
# Chain id. Defaults to 1 (mainnet); set 31337 for a local fork or another id only on purpose.
VITE_CHAIN_ID=1
# First block to scan for factory and vault events; set it to the factory deploy block.
VITE_FROM_BLOCK=
# Keeper address prefilled in the create form (optional).
VITE_DEFAULT_KEEPER=
# WalletConnect Cloud project id (optional). Without it only browser (injected) wallets are offered.
VITE_WALLETCONNECT_PROJECT_ID=
